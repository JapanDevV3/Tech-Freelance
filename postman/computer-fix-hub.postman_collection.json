    {
      "name": "1 · Setup",
      "item": [
        {
          "name": "Technician · Create service (once)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reuse the service from an earlier run instead of creating one per run.",
                  "// Clear the collection variable `serviceId` to create a fresh one.",
                  "if (pm.collectionVariables.get('serviceId')) {",
                  "    console.log('serviceId already set — skipping create');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('serviceId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{technicianHost}}/api/v1/services",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman · ลง Windows + ไดรเวอร์\",\n  \"category\": \"install_windows\",\n  \"priceBaht\": 500,\n  \"duration\": \"days_1_2\",\n  \"mode\": \"remote\",\n  \"serviceArea\": \"\",\n  \"description\": \"Created by the Postman collection for API tests\",\n  \"status\": \"active\",\n  \"imageKeys\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
