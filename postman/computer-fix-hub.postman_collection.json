{
  "info": {
    "_postman_id": "6d4297b6-b81a-4734-9486-f8e4b8b91597",
    "name": "computer-fix-hub API",
    "description": "API tests for /api/v1 — run the whole collection in order with the Collection Runner.\n\nSetup: import the environment file, fill in the two test accounts (one customer, one technician WITH a technician profile), select the environment.\n\nWhy two hosts: Postman keeps one cookie jar per domain. The customer signs in on localhost and the technician on 127.0.0.1, so both sessions live side by side.\n\nRate limits apply here too (login 5 per email / 15 min, createOrder 20/h, sendQuote 30/h). In dev the memory limiter resets when you restart `npm run dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 · Auth (run first)",
      "description": "Signs both users in. Customer cookies live on `customerHost`, technician cookies on `technicianHost` — two hostnames = two cookie jars, so both sessions stay alive in one run.",
      "item": [
        {
          "name": "Customer · CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Auth.js double-submit CSRF: the token in the body must match the csrf cookie it just set",
                  "pm.test('200 + csrfToken', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('customerCsrf', pm.response.json().csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customerHost}}/api/auth/csrf"
          }
        },
        {
          "name": "Customer · Sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Success sets the session cookie in Postman's jar for THIS host.",
                  "// Failure still answers 200, with the reason in the returned URL (?error=…&code=…)",
                  "pm.test('signed in (no error in the redirect URL)', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const url = pm.response.json().url || '';",
                  "    pm.expect(url, url).to.not.include('error=');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Auth-Return-Redirect",
                "value": "1",
                "description": "Ask Auth.js for JSON {url} instead of a 302 — what next-auth/react signIn() does"
              }
            ],
            "url": "{{customerHost}}/api/auth/callback/credentials",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{customerEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{customerPassword}}",
                  "type": "text"
                },
                {
                  "key": "csrfToken",
                  "value": "{{customerCsrf}}",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Customer · Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('session belongs to a customer', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.user, 'no session — check credentials or the rate limit').to.be.an('object');",
                  "    pm.expect(json.user.role).to.eql('customer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{customerHost}}/api/auth/session"
          }
        },
        {
          "name": "Technician · CSRF token",
